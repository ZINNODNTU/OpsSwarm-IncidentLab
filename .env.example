# GitHub system-of-record
GITHUB_REPO=ZINNODNTU/OpsSwarm-IncidentLab
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# OpenClaw gateway. Generate a long random value before deployment.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.6

# MiniMax provider used by all OpsSwarm OpenClaw agents.
MINIMAX_API_KEY=

# Internal URL embedded in IncidentLab evidence/Issue payloads.
# Keep this as the Docker service DNS name unless you have a routable server URL.
INCIDENTLAB_AGENT_URL=http://incidentlab:8080
INCIDENTLAB_FALLBACK_URL=http://incidentlab:8080

# Host ports
INCIDENTLAB_PORT=8080
OPSSWARM_PORT=8088
AUTH_PORT=8001
ORDER_PORT=8002
INVENTORY_PORT=8003
PAYMENT_PORT=8004
BOOKING_API_PORT=8005
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# OpsSwarm behavior
OPSWARM_GITHUB_POLL_ENABLED=true
OPSWARM_GITHUB_POLL_SECONDS=2
OPSWARM_OPENCLAW_TIMEOUT=600
